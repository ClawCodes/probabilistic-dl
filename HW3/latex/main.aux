\@writefile{toc}{\contentsline {section}{\numberline {5}MC\_RTT population activity}{3}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}Validation performance and latent capacity}{3}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Training (solid) and held-out validation (dashed) loss components for each MC\_RTT latent size. Larger models continue to reduce training reconstruction error, while validation reconstruction plateaus or rises modestly late in training.}}{3}{}\protected@file@percent }
\newlabel{fig:mc-rtt-training}{{3}{3}{}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Final held-out loss, reconstruction error, and KL divergence by latent dimension. All dimensions exceeded the active-dimension threshold, so the larger models did not show posterior collapse under this criterion.}}{4}{}\protected@file@percent }
\newlabel{fig:mc-rtt-latent-sweep}{{4}{4}{}{figure.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Reconstruction and conditional generation}{4}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Three held-out rate windows (top) and their reconstructions from the $z=8$ cVAE (bottom), displayed on one color scale. The reconstructions retain broad unit- and time-dependent structure but smooth trial-specific variation.}}{4}{}\protected@file@percent }
\newlabel{fig:mc-rtt-reconstruction}{{5}{4}{}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Mean held-out (black) and generated (dashed orange) log1p firing-rate profiles for each of the eight velocity-direction conditions, using $z=8$.}}{5}{}\protected@file@percent }
\newlabel{fig:mc-rtt-profiles}{{6}{5}{}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Held-out windows and conditional samples projected onto the top two principal components fit to held-out data. Samples cover the central population cloud but underrepresent the most extreme held-out variation.}}{5}{}\protected@file@percent }
\newlabel{fig:mc-rtt-pca}{{7}{5}{}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Held-out direction-2 windows compared with conditional samples at each latent size. Averaged samples recover broad rate structure; individual samples are smoother and less heterogeneous than held-out trials.}}{6}{}\protected@file@percent }
\newlabel{fig:mc-rtt-samples-latent}{{8}{6}{}{figure.8}{}}
